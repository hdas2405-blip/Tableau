    <dashboard enable-sort-zone-taborder='true' lock-updates='true' name='Q1'>
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Benton Sans Book'>Q1: Explain the difference between a Tableau Dashboard and a Tableau Story Point. Give two healthcare-related use cases. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Tableau Dashboard:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> A dashboard is a single, consolidated view of multiple worksheets (charts, maps, tables). It is designed to be highly interactive, allowing users to filter and slice data dynamically to find immediate answers. It is best used for operational monitoring.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Healthcare Use Case:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> A &quot;Live ER Operations Dashboard&quot; showing current wait times, available beds, and active triage cases. Hospital administrators can use this to make minute-by-minute decisions.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Tableau Story Point:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> A story is a sequential presentation of dashboards or individual worksheets. It is designed to guide the viewer through a specific narrative or a step-by-step analysis, much like a PowerPoint presentation but with live data.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Healthcare Use Case:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> A &quot;Quarterly Readmission Analysis Story.&quot; Point 1 shows the overall increase in readmissions. Point 2 breaks it down by department. Point 3 highlights the specific medications correlated with readmissions, driving a final conclusion for the hospital board.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='10' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='9' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>Q1: Explain the difference between a Tableau Dashboard and a Tableau Story Point. Give two healthcare-related use cases. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Tableau Dashboard:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> A dashboard is a single, consolidated view of multiple worksheets (charts, maps, tables). It is designed to be highly interactive, allowing users to filter and slice data dynamically to find immediate answers. It is best used for operational monitoring.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Healthcare Use Case:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> A &quot;Live ER Operations Dashboard&quot; showing current wait times, available beds, and active triage cases. Hospital administrators can use this to make minute-by-minute decisions.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Tableau Story Point:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> A story is a sequential presentation of dashboards or individual worksheets. It is designed to guide the viewer through a specific narrative or a step-by-step analysis, much like a PowerPoint presentation but with live data.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Healthcare Use Case:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> A &quot;Quarterly Readmission Analysis Story.&quot; Point 1 shows the overall increase in readmissions. Point 2 breaks it down by department. Point 3 highlights the specific medications correlated with readmissions, driving a final conclusion for the hospital board.</run>
                  </formatted-text>
